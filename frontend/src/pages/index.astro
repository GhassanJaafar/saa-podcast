---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { getEpisodes, getSeasons, getSettings, imageUrl, seasonMap } from '../lib/sanity';
import { ui } from '../i18n/ui';

const [episodes, seasons, settings] = await Promise.all([
  getEpisodes(),
  getSeasons(),
  getSettings(),
]);

const seasonsByNumber = seasonMap(seasons);

function formatDate(dateStr: string | undefined, locale: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString(locale, {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

/** Sanity stores duration as "HH:MM:SS" (or "MM:SS"). */
function parseDuration(val: string | undefined) {
  if (!val) return null;
  const parts = String(val).split(':').map(Number);
  if (parts.length < 2 || parts.some(isNaN)) return null;
  const [h, m, s] = parts.length === 3 ? parts : [0, parts[0], parts[1]];
  return { h, m, s };
}

function formatDuration(val: string | undefined, lang: 'en' | 'ar') {
  const d = parseDuration(val);
  if (!d) return '';
  const hr = ui.hoursShort[lang];
  const min = ui.minutesShort[lang];
  const sec = ui.secondsShort[lang];
  if (d.h > 0) return `${d.h}${hr} ${d.m}${min}`;
  return `${d.m}${min} ${String(d.s ?? 0).padStart(2, '0')}${sec}`;
}

// Group by season, newest season first
const bySeason = new Map<number, typeof episodes>();
for (const ep of episodes) {
  const s = ep.season ?? 1;
  if (!bySeason.has(s)) bySeason.set(s, []);
  bySeason.get(s)!.push(ep);
}
const seasonNumbers = [...bySeason.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title={settings.shortTitle || settings.siteTitle}
  description={settings.description}
>
  <div class="page-intro">
    <h1><T en={ui.episodes.en} ar={ui.episodes.ar} /></h1>
  </div>

  {episodes.length === 0 ? (
    <p class="empty-state"><T en={ui.comingSoon.en} ar={ui.comingSoon.ar} /></p>
  ) : (
    seasonNumbers.map((num) => {
      const season = seasonsByNumber[num];
      return (
        <section class="season-section">
          {seasonNumbers.length > 1 && (
            <p class="season-heading">
              <T
                en={season?.title || `${ui.season.en} ${num}`}
                ar={season?.titleAr || `${ui.season.ar} ${num}`}
              />
            </p>
          )}
          <ul class="episode-list">
            {bySeason.get(num)!.map((ep) => {
              const thumb =
                imageUrl(ep.coverImage, 144, 144) ||
                imageUrl(season?.coverImage, 144, 144) ||
                imageUrl(settings.coverImage, 144, 144);
              return (
                <li class="episode-card">
                  <span class="episode-num">{ep.episodeNumber ?? '—'}</span>

                  <div class="episode-body">
                    <h2 class="episode-title">
                      <a href={`/episodes/${ep.slug}`}>
                        <T en={ep.title} ar={ep.titleAr} />
                      </a>
                    </h2>

                    <p class="episode-meta">
                      {ep.publishedAt && (
                        <span>
                          <T
                            en={formatDate(ep.publishedAt, 'en-GB')}
                            ar={formatDate(ep.publishedAt, 'ar-EG')}
                          />
                        </span>
                      )}
                      {ep.duration && (
                        <span>
                          <T
                            en={formatDuration(ep.duration, 'en')}
                            ar={formatDuration(ep.duration, 'ar')}
                          />
                        </span>
                      )}
                    </p>

                    {ep.description && (
                      <p class="episode-desc">
                        <T en={ep.description} ar={ep.descriptionAr} block />
                      </p>
                    )}
                  </div>

                  {thumb && (
                    <img
                      src={thumb}
                      alt={`Cover for ${ep.title}`}
                      class="episode-cover-thumb"
                      width="72"
                      height="72"
                      loading="lazy"
                    />
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      );
    })
  )}

  <style>
    .page-intro { margin-bottom: 2rem; }
    .page-intro h1 {
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      font-weight: 300;
      line-height: 1.3;
      letter-spacing: 0.01em;
      margin: 0;
    }

    .season-section { margin-bottom: 3rem; }
    .season-heading {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--saa-muted);
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 0.0625rem solid var(--saa-sand);
    }

    .episode-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* Cream card, sand border — the SAA contrast stack */
    .episode-card {
      background: var(--saa-cream);
      border: 0.0625rem solid var(--saa-sand);
      border-radius: var(--saa-radius-card);
      padding: 1.25rem 1.5rem;
      display: grid;
      grid-template-columns: 2.5rem 1fr auto;
      gap: 0 1rem;
      align-items: start;
      transition: border-color var(--saa-transition);
    }
    .episode-card:hover { border-color: var(--saa-input-border); }

    .episode-num {
      font-size: 0.78rem;
      font-weight: 300;
      color: var(--saa-muted);
      padding-top: 0.2rem;
      text-align: right;
    }

    .episode-cover-thumb {
      width: 4.5rem;
      height: 4.5rem;
      object-fit: cover;
      border: 0.0625rem solid var(--saa-sand);
      flex-shrink: 0;
    }

    .episode-title {
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.35;
      margin: 0 0 0.3rem;
    }
    .episode-title a {
      color: var(--saa-text);
      text-decoration: none;
    }
    .episode-title a:hover { color: var(--saa-accent); opacity: 1; }

    .episode-meta {
      font-size: 0.78rem;
      font-weight: 300;
      color: var(--saa-muted);
      margin: 0 0 0.5rem;
    }
    .episode-meta span + span::before { content: " · "; }

    .episode-desc {
      font-size: 0.875rem;
      font-weight: 300;
      line-height: 1.6;
      color: var(--saa-text);
      opacity: 0.8;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .empty-state {
      font-style: italic;
      color: var(--saa-muted);
      font-weight: 300;
      padding: 2rem 0;
    }

    @media (max-width: 30rem) {
      .episode-card {
        grid-template-columns: 2rem 1fr;
        padding: 1rem;
      }
      .episode-cover-thumb { display: none; }
    }
  </style>
</BaseLayout>
