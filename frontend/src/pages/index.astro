---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { getSiteData, imageUrl, seasonMap } from '../lib/sanity';
import { ui } from '../i18n/ui';

const { episodes, seasons, settings } = await getSiteData();

const seasonsByNumber = seasonMap(seasons);

// Social-share image (Open Graph / Twitter). The podcast-level cover in Studio
// is the intended source; fall back to the newest episode's cover, then any
// season cover, so a shared homepage link always previews real cover art
// rather than a missing placeholder file.
const shareImage =
  imageUrl(settings.coverImage, 1400, 1400) ||
  imageUrl(episodes[0]?.coverImage, 1400, 1400) ||
  imageUrl(seasons[0]?.coverImage, 1400, 1400) ||
  undefined;

function formatDate(dateStr: string | undefined, locale: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString(locale, {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

/** Sanity stores duration as "HH:MM:SS" (or "MM:SS"). */
function parseDuration(val: string | undefined) {
  if (!val) return null;
  const parts = String(val).split(':').map(Number);
  if (parts.length < 2 || parts.some(isNaN)) return null;
  const [h, m, s] = parts.length === 3 ? parts : [0, parts[0], parts[1]];
  return { h, m, s };
}

function formatDuration(val: string | undefined, lang: 'en' | 'ar') {
  const d = parseDuration(val);
  if (!d) return '';
  const hr = ui.hoursShort[lang];
  const min = ui.minutesShort[lang];
  const sec = ui.secondsShort[lang];
  if (d.h > 0) return `${d.h}${hr} ${d.m}${min}`;
  return `${d.m}${min} ${String(d.s ?? 0).padStart(2, '0')}${sec}`;
}

// Group by season, newest season first
const bySeason = new Map<number, typeof episodes>();
for (const ep of episodes) {
  const s = ep.season ?? 1;
  if (!bySeason.has(s)) bySeason.set(s, []);
  bySeason.get(s)!.push(ep);
}
const seasonNumbers = [...bySeason.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title={settings.shortTitle || settings.siteTitle}
  description={settings.description}
  ogImage={shareImage}
>
  <div class="page-intro">
    <h1><T en={ui.episodes.en} ar={ui.episodes.ar} /></h1>
  </div>

  {episodes.length === 0 ? (
    <p class="empty-state"><T en={ui.comingSoon.en} ar={ui.comingSoon.ar} /></p>
  ) : (
    seasonNumbers.map((num) => {
      const season = seasonsByNumber[num];
      // One large cover for the whole season, shown above the episode list:
      // season art → the newest episode's art in this season → podcast cover.
      const seasonCover =
        imageUrl(season?.coverImage, 800, 800) ||
        imageUrl(bySeason.get(num)!.find((e) => e.coverImage)?.coverImage, 800, 800) ||
        imageUrl(settings.coverImage, 800, 800);
      const multiSeason = seasonNumbers.length > 1;
      // Beside the cover: the season title (when there is more than one season)
      // or the podcast title otherwise, plus a blurb — the season's own
      // description if it has one, else the podcast description.
      const introTitleEn = multiSeason ? (season?.title || `${ui.season.en} ${num}`) : settings.siteTitle;
      const introTitleAr = multiSeason ? (season?.titleAr || `${ui.season.ar} ${num}`) : settings.siteTitleAr;
      const introBodyEn = season?.description || settings.description;
      const introBodyAr = season?.descriptionAr || settings.descriptionAr;
      return (
        <section class="season-section">
          <div class="season-intro">
            {seasonCover && (
              <img
                src={seasonCover}
                alt={introTitleEn}
                class="season-cover"
                width="400"
                height="400"
              />
            )}
            <div class="season-intro__text">
              {multiSeason && (
                <p class="season-eyebrow">
                  <T en={`${ui.season.en} ${num}`} ar={`${ui.season.ar} ${num}`} />
                </p>
              )}
              <h2 class="season-title">
                <T en={introTitleEn} ar={introTitleAr} />
              </h2>
              {introBodyEn && (
                <div class="season-about">
                  <T en={introBodyEn} ar={introBodyAr} block />
                </div>
              )}
            </div>
          </div>
          <ul class="episode-list">
            {bySeason.get(num)!.map((ep) => (
              <li class="episode-card">
                <span class="episode-num">{ep.episodeNumber ?? '—'}</span>

                <div class="episode-body">
                  <h2 class="episode-title">
                    <a href={`/episodes/${ep.slug}`}>
                      <T en={ep.title} ar={ep.titleAr} />
                    </a>
                  </h2>

                  <p class="episode-meta">
                    {ep.publishedAt && (
                      <span>
                        <T
                          en={formatDate(ep.publishedAt, 'en-GB')}
                          ar={formatDate(ep.publishedAt, 'ar-EG')}
                        />
                      </span>
                    )}
                    {ep.duration && (
                      <span>
                        <T
                          en={formatDuration(ep.duration, 'en')}
                          ar={formatDuration(ep.duration, 'ar')}
                        />
                      </span>
                    )}
                  </p>

                  {ep.description && (
                    <p class="episode-desc">
                      <T en={ep.description} ar={ep.descriptionAr} block />
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  )}

  <style>
    .page-intro { margin-bottom: 2rem; }
    .page-intro h1 {
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      font-weight: 300;
      line-height: 1.3;
      letter-spacing: 0.01em;
      margin: 0;
    }

    .season-section { margin-bottom: 3rem; }

    /* Cover on one side, title + blurb on the other, above the episode list. */
    .season-intro {
      display: flex;
      gap: 1.75rem;
      align-items: flex-start;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 0.0625rem solid var(--saa-sand);
    }
    .season-cover {
      width: 14rem;
      flex-shrink: 0;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border: 0.0625rem solid var(--saa-sand);
    }
    .season-intro__text {
      flex: 1;
      min-width: 0;
    }
    .season-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--saa-muted);
      margin: 0 0 0.5rem;
    }
    .season-title {
      font-size: clamp(1.25rem, 3vw, 1.75rem);
      font-weight: 300;
      line-height: 1.25;
      margin: 0 0 0.9rem;
    }
    .season-about {
      font-size: 0.95rem;
      font-weight: 300;
      line-height: 1.7;
      color: var(--saa-text);
      opacity: 0.85;
    }
    .season-about :global(p) { margin: 0 0 0.75rem; }
    .season-about :global(p:last-child) { margin-bottom: 0; }

    .episode-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* Cream card, sand border — the SAA contrast stack */
    .episode-card {
      background: var(--saa-cream);
      border: 0.0625rem solid var(--saa-sand);
      border-radius: var(--saa-radius-card);
      padding: 1.25rem 1.5rem;
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: 0 1rem;
      align-items: start;
      transition: border-color var(--saa-transition);
    }
    .episode-card:hover { border-color: var(--saa-input-border); }

    .episode-num {
      font-size: 0.78rem;
      font-weight: 300;
      color: var(--saa-muted);
      padding-top: 0.2rem;
      text-align: right;
    }

    .episode-title {
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.35;
      margin: 0 0 0.3rem;
    }
    .episode-title a {
      color: var(--saa-text);
      text-decoration: none;
    }
    .episode-title a:hover { color: var(--saa-accent); opacity: 1; }

    .episode-meta {
      font-size: 0.78rem;
      font-weight: 300;
      color: var(--saa-muted);
      margin: 0 0 0.5rem;
    }
    .episode-meta span + span::before { content: " · "; }

    .episode-desc {
      font-size: 0.875rem;
      font-weight: 300;
      line-height: 1.6;
      color: var(--saa-text);
      opacity: 0.8;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .empty-state {
      font-style: italic;
      color: var(--saa-muted);
      font-weight: 300;
      padding: 2rem 0;
    }

    /* Stack the cover and text, and let the cover fill the width, before it
       gets too cramped to sit side by side. */
    @media (max-width: 40rem) {
      .season-intro {
        flex-direction: column;
        gap: 1.25rem;
      }
      .season-cover {
        width: 100%;
        max-width: none;
      }
    }

    @media (max-width: 30rem) {
      .episode-card {
        grid-template-columns: 2rem 1fr;
        padding: 1rem;
      }
    }
  </style>
</BaseLayout>
