---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { ui } from '../i18n/ui';

Astro.response.status = 404;
---

<BaseLayout title={ui.notFoundTitle.en} description={ui.notFoundBody.en} noindex>
  <div class="not-found">
    <span class="not-found__code">404</span>
    <h1><T en={ui.notFoundTitle.en} ar={ui.notFoundTitle.ar} /></h1>
    <p><T en={ui.notFoundBody.en} ar={ui.notFoundBody.ar} block /></p>
    <a href="/" class="not-found__back">
      <T en={ui.backToEpisodes.en} ar={ui.backToEpisodes.ar} />
    </a>
  </div>

  <style>
    .not-found {
      padding: 4rem 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .not-found__code {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--saa-muted);
    }
    .not-found h1 {
      font-size: clamp(2.5rem, 7vw, 4.5rem);
      font-weight: 300;
      line-height: 1;
      letter-spacing: -0.02em;
      margin: 0;
    }
    .not-found p {
      font-size: 0.9375rem;
      font-weight: 300;
      color: var(--saa-muted);
      max-width: 42ch;
      line-height: 1.6;
      margin: 0;
    }
    .not-found__back {
      margin-top: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--saa-muted);
      border-bottom: 0.0625rem solid var(--saa-sand);
      padding-bottom: 0.125rem;
      transition: color var(--saa-transition), border-color var(--saa-transition);
    }
    .not-found__back:hover {
      color: var(--saa-accent);
      border-color: var(--saa-accent);
      opacity: 1;
    }
  </style>
</BaseLayout>
