---
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/T.astro';
import { getEpisode, getSeasons, getSettings, imageUrl, seasonMap } from '../../lib/sanity';
import { ui } from '../../i18n/ui';

// No getStaticPaths — routes are rendered on demand so a new episode published
// in Sanity is live immediately, without a redeploy.
const { slug } = Astro.params;

const episode = await getEpisode(slug!);
if (!episode) {
  return Astro.rewrite('/404');
}

const [seasons, settings] = await Promise.all([getSeasons(), getSettings()]);
const season = seasonMap(seasons)[episode.season ?? 1];

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || 'https://podcast.sudanartarchive.com';

function formatDate(dateStr: string | undefined, locale: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString(locale, {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

function formatDuration(val: string | undefined, lang: 'en' | 'ar') {
  if (!val) return '';
  const parts = String(val).split(':').map(Number);
  if (parts.length < 2 || parts.some(isNaN)) return '';
  const [h, m, s] = parts.length === 3 ? parts : [0, parts[0], parts[1]];
  const hr = ui.hoursShort[lang];
  const min = ui.minutesShort[lang];
  const sec = ui.secondsShort[lang];
  if (h > 0) return `${h} ${hr} ${m} ${min}`;
  return `${m} ${min} ${String(s ?? 0).padStart(2, '0')} ${sec}`;
}

// Cover art cascade: episode → season → podcast default
const cover =
  imageUrl(episode.coverImage, 640, 640) ||
  imageUrl(season?.coverImage, 640, 640) ||
  imageUrl(settings.coverImage, 640, 640);

const ogImage =
  imageUrl(episode.coverImage, 1400, 1400) ||
  imageUrl(season?.coverImage, 1400, 1400) ||
  imageUrl(settings.coverImage, 1400, 1400) ||
  undefined;

const canonicalUrl = `${siteUrl}/episodes/${slug}`;
const seasonNum = episode.season ?? 1;
---

<BaseLayout
  title={episode.title}
  description={episode.description || `${ui.episode.en} ${episode.episodeNumber} — ${settings.siteTitle}`}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  type="article"
>
  <a href="/" class="back-link">
    <T en={ui.allEpisodes.en} ar={ui.allEpisodes.ar} />
  </a>

  <article>
    <header class="episode-header">
      <p class="episode-label">
        <T
          en={`${ui.season.en} ${seasonNum} · ${ui.episode.en} ${episode.episodeNumber ?? ''}`.trim()}
          ar={`${ui.season.ar} ${seasonNum} · ${ui.episode.ar} ${episode.episodeNumber ?? ''}`.trim()}
        />
      </p>

      <h1><T en={episode.title} ar={episode.titleAr} /></h1>

      <div class="episode-meta">
        {episode.publishedAt && (
          <span>
            <T
              en={formatDate(episode.publishedAt, 'en-GB')}
              ar={formatDate(episode.publishedAt, 'ar-EG')}
            />
          </span>
        )}
        {episode.duration && (
          <span>
            <T
              en={formatDuration(episode.duration, 'en')}
              ar={formatDuration(episode.duration, 'ar')}
            />
          </span>
        )}
        {episode.explicit && (
          <span><T en={ui.explicit.en} ar={ui.explicit.ar} /></span>
        )}
      </div>

      {cover && (
        <img
          src={cover}
          alt={`Cover art for ${episode.title}`}
          class="episode-cover"
          width="320"
          height="320"
        />
      )}

      {episode.audioUrl ? (
        <div class="custom-player">
          <audio id="ep-audio" preload="metadata" src={episode.audioUrl}></audio>

          <div class="player-row">
            <button
              class="player-play-btn"
              id="ep-play-btn"
              type="button"
              aria-label={ui.playEpisode.en}
              data-label-play={ui.playEpisode.en}
              data-label-pause={ui.pauseEpisode.en}
            >
              <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="6,3 20,12 6,21" />
              </svg>
              <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="5" y="4" width="4" height="16" rx="1" />
                <rect x="15" y="4" width="4" height="16" rx="1" />
              </svg>
            </button>

            <div class="player-meta">
              <div class="player-track">
                <div class="player-fill" id="ep-fill"></div>
                <input
                  type="range"
                  class="player-seek"
                  id="ep-seek"
                  min="0"
                  max="100"
                  value="0"
                  step="0.1"
                  aria-label={ui.seek.en}
                />
              </div>
              <div class="player-time">
                <span id="ep-current">0:00</span>
                <span id="ep-total">–:––</span>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <p class="audio-pending">
          <T en={ui.audioComingSoon.en} ar={ui.audioComingSoon.ar} />
        </p>
      )}
    </header>

    {episode.description && (
      <div class="episode-description">
        <div class="en-block">
          {episode.description.split('\n').map((line) => (line ? <p>{line}</p> : <br />))}
        </div>
        <div class="ar-block" dir="rtl">
          {(episode.descriptionAr || episode.description)
            .split('\n')
            .map((line) => (line ? <p>{line}</p> : <br />))}
        </div>
      </div>
    )}
  </article>

  <style>
    .back-link {
      display: inline-block;
      font-size: 0.875rem;
      font-weight: 300;
      text-decoration: none;
      color: var(--saa-muted);
      margin-bottom: 2rem;
      transition: color var(--saa-transition);
    }
    .back-link:hover { color: var(--saa-accent); opacity: 1; }
    .back-link::before { content: "← "; }
    :global(html.lang-ar) .back-link::before { content: "→ "; }

    .episode-header {
      background: var(--saa-cream);
      border: 0.0625rem solid var(--saa-sand);
      border-radius: var(--saa-radius-card);
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .episode-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--saa-muted);
      margin: 0 0 0.6rem;
    }

    h1 {
      font-size: clamp(1.5rem, 4vw, 2.25rem);
      font-weight: 300;
      line-height: 1.25;
      margin-bottom: 0.75rem;
    }

    .episode-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
      font-size: 0.82rem;
      font-weight: 300;
      color: var(--saa-muted);
      margin-bottom: 1.5rem;
    }

    .episode-cover {
      width: 100%;
      max-width: 17.5rem;
      margin-bottom: 1.75rem;
      border: 0.0625rem solid var(--saa-sand);
    }

    .audio-pending {
      font-style: italic;
      color: var(--saa-muted);
      font-size: 0.9rem;
      margin-bottom: 0;
    }

    /* ── Custom audio player ─────────────────────────────────── */
    .custom-player {
      background: var(--saa-white);
      border: 0.0625rem solid var(--saa-sand);
      border-radius: var(--saa-radius-card);
      padding: 1.25rem 1.5rem;
    }

    .player-row {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .player-play-btn {
      width: 2.75rem;
      height: 2.75rem;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--saa-text);
      color: var(--saa-cream);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--saa-transition), transform var(--saa-transition);
    }
    .player-play-btn:hover  { background: var(--saa-accent); }
    .player-play-btn:active { transform: scale(0.93); }
    .player-play-btn svg    { width: 0.875rem; height: 0.875rem; }
    .player-play-btn .icon-play  { display: block; margin-left: 0.125rem; }
    .player-play-btn .icon-pause { display: none; }
    .player-play-btn.is-playing .icon-play  { display: none; }
    .player-play-btn.is-playing .icon-pause { display: block; margin-left: 0; }

    .player-meta {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .player-track {
      position: relative;
      height: 0.1875rem;
      background: var(--saa-sand);
      cursor: pointer;
    }
    .player-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: 0%;
      background: var(--saa-accent);
      pointer-events: none;
    }
    .player-seek {
      position: absolute;
      inset: -0.75rem 0;
      width: 100%;
      opacity: 0;
      cursor: pointer;
      margin: 0;
      -webkit-appearance: none;
      appearance: none;
    }

    .player-time {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      font-weight: 300;
      color: var(--saa-muted);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
      /* Time always reads left-to-right, even in Arabic */
      direction: ltr;
    }

    .episode-description {
      font-size: 1rem;
      font-weight: 300;
      line-height: 1.75;
      color: var(--saa-text);
    }
    .episode-description p { margin: 0 0 1rem; }

    @media (max-width: 30rem) {
      .episode-header { padding: 1.25rem; }
      .custom-player { padding: 1rem; }
    }
  </style>
</BaseLayout>

<script>
  const audio   = document.getElementById('ep-audio')    as HTMLAudioElement | null;
  const playBtn = document.getElementById('ep-play-btn') as HTMLButtonElement | null;
  const seekEl  = document.getElementById('ep-seek')     as HTMLInputElement  | null;
  const fillEl  = document.getElementById('ep-fill')     as HTMLDivElement    | null;
  const curEl   = document.getElementById('ep-current')  as HTMLElement       | null;
  const totEl   = document.getElementById('ep-total')    as HTMLElement       | null;

  if (audio && playBtn && seekEl && fillEl && curEl && totEl) {
    const fmt = (s: number): string => {
      if (!s || isNaN(s)) return '–:––';
      const m   = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${m}:${sec.toString().padStart(2, '0')}`;
    };

    audio.addEventListener('loadedmetadata', () => {
      totEl.textContent = fmt(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      fillEl.style.width = pct + '%';
      seekEl.value       = String(pct);
      curEl.textContent  = fmt(audio.currentTime);
    });

    audio.addEventListener('play', () => {
      playBtn.classList.add('is-playing');
      playBtn.setAttribute('aria-label', playBtn.dataset.labelPause || 'Pause');
    });
    audio.addEventListener('pause', () => {
      playBtn.classList.remove('is-playing');
      playBtn.setAttribute('aria-label', playBtn.dataset.labelPlay || 'Play');
    });
    audio.addEventListener('ended', () => {
      playBtn.classList.remove('is-playing');
      playBtn.setAttribute('aria-label', playBtn.dataset.labelPlay || 'Play');
      fillEl.style.width = '0%';
      seekEl.value       = '0';
      curEl.textContent  = '0:00';
    });

    playBtn.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });

    seekEl.addEventListener('input', () => {
      if (!audio.duration) return;
      audio.currentTime = (Number(seekEl.value) / 100) * audio.duration;
    });
  }
</script>
