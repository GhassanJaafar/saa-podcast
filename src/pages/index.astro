---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "../lib/sanity";

const episodes = await sanityClient.fetch(`
  *[_type == "episode" && defined(slug.current)] | order(publishedAt desc) {
    title,
    episodeNumber,
    "slug": slug.current,
    publishedAt,
    description,
    duration,
    season
  }
`);

function formatDate(dateStr: string) {
  if (!dateStr) return "";
  return new Date(dateStr).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function formatDuration(val: unknown) {
  if (!val) return "";
  // Sanity stores duration as "HH:MM:SS" string
  const parts = String(val).split(":").map(Number);
  if (parts.length < 2 || parts.some(isNaN)) return "";
  const [h, m, s] = parts.length === 3 ? parts : [0, parts[0], parts[1]];
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m ${String(s ?? 0).padStart(2, "0")}s`;
}

// Group by season
const bySeason: Record<number, typeof episodes> = {};
for (const ep of episodes) {
  const s = ep.season ?? 1;
  (bySeason[s] ||= []).push(ep);
}
const seasons = Object.keys(bySeason)
  .map(Number)
  .sort((a, b) => b - a); // newest season first
---

<BaseLayout
  title="SAA Podcast"
  description="Sudan Art Archive Podcast — Preserving 50 Years of Sudanese Artistry!"
>
  <style>
    .page-intro { margin-bottom: 2rem; }
    .page-intro h1 { font-size: 1.1rem; font-weight: 600; line-height: 1.3; letter-spacing: 0.01em; }

    .season-section { margin-bottom: 3rem; }
    .season-heading {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      opacity: 0.5;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(36,38,38,0.12);
    }

    .episode-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .episode-card {
      padding: 1.25rem 0;
      border-bottom: 1px solid rgba(36,38,38,0.1);
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: 0 1rem;
    }
    .episode-card:first-child { border-top: 1px solid rgba(36,38,38,0.1); }

    .episode-num {
      font-size: 0.78rem;
      font-weight: 300;
      opacity: 0.45;
      padding-top: 0.2rem;
      text-align: right;
    }

    .episode-body {}
    .episode-title {
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.35;
      margin-bottom: 0.3rem;
    }
    .episode-title a { text-decoration: none; }
    .episode-title a:hover { color: var(--color-hover); }

    .episode-meta {
      font-size: 0.78rem;
      font-weight: 300;
      opacity: 0.6;
      margin-bottom: 0.5rem;
    }
    .episode-meta span + span::before { content: " · "; }

    .episode-desc {
      font-size: 0.88rem;
      font-weight: 300;
      line-height: 1.6;
      opacity: 0.8;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .empty-state { font-style: italic; opacity: 0.55; font-weight: 300; padding: 2rem 0; }
  </style>

  <div class="page-intro">
    <h1>Episodes</h1>
  </div>

  {episodes.length === 0 ? (
    <p class="empty-state">Episodes coming soon.</p>
  ) : (
    seasons.map((season) => (
      <section class="season-section">
        {seasons.length > 1 && (
          <p class="season-heading">Season {season}</p>
        )}
        <ul class="episode-list">
          {bySeason[season].map((ep) => (
            <li class="episode-card">
              <span class="episode-num">{ep.episodeNumber ?? "—"}</span>
              <div class="episode-body">
                <h2 class="episode-title">
                  <a href={`/episodes/${ep.slug}`}>{ep.title}</a>
                </h2>
                <p class="episode-meta">
                  {ep.publishedAt && <span>{formatDate(ep.publishedAt)}</span>}
                  {ep.duration   && <span>{formatDuration(ep.duration)}</span>}
                </p>
                {ep.description && (
                  <p class="episode-desc">{ep.description}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}

</BaseLayout>
