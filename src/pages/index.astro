---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';

const episodes = await sanityClient.fetch(`
  *[_type == "episode" && defined(slug.current) && defined(publishedAt) && defined(audioUrl)]
  | order(episodeNumber desc) {
    title,
    episodeNumber,
    season,
    publishedAt,
    description,
    duration,
    "slug": slug.current
  }
`);
---

<Layout
  title="Sudan Art Archive Podcast — Episodes"
  description="Conversations on Sudanese art, culture, and creativity. Hosted by Sudan Art Archive."
>

  <!-- ── Page header ── -->
  <div class="pb-10 border-b border-saa-border">
    <p class="font-sans text-[9px] font-semibold tracking-[0.2em] uppercase text-saa-muted mb-3">
      Sudan Art Archive
    </p>
    <h1 class="font-serif text-[clamp(2.75rem,7vw,5rem)] font-light tracking-tight leading-none mb-4 text-saa-black">
      Podcast
    </h1>
    <p class="font-sans text-sm text-saa-muted leading-relaxed max-w-xl">
      Conversations on Sudanese art, culture, and creativity.
    </p>
  </div>

  <!-- ── Episode list ── -->
  {episodes.length === 0 ? (
    <p class="py-20 font-sans text-sm text-saa-muted">No episodes yet. Check back soon.</p>
  ) : (
    <ol aria-label="Episode list" class="divide-y divide-saa-border">
      {episodes.map((ep: any) => (
        <li>
          <a
            href={`/episodes/${ep.slug}`}
            aria-label={`Listen to episode ${ep.episodeNumber}: ${ep.title}`}
            class="block py-8 no-underline text-saa-black hover:opacity-60 transition-opacity focus-visible:outline-2 focus-visible:outline-saa-black focus-visible:outline-offset-4 rounded-sm"
          >
            <!-- row: episode label + date -->
            <div class="flex items-baseline justify-between gap-4 mb-2.5 flex-wrap">
              <span class="font-sans text-[9px] font-semibold tracking-[0.18em] uppercase text-saa-muted">
                {ep.season ? `S${ep.season} · ` : ''}Ep. {ep.episodeNumber}
              </span>
              <span class="font-sans text-[11px] text-saa-muted">
                {new Date(ep.publishedAt).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
                {ep.duration && <span> · {ep.duration}</span>}
              </span>
            </div>

            <!-- title: IBM Plex Serif -->
            <h2 class="font-serif text-[clamp(1.3rem,3.5vw,1.9rem)] font-normal leading-snug mb-3 text-saa-black">
              {ep.title}
            </h2>

            <!-- description (2-line clamp) -->
            {ep.description && (
              <p class="font-sans text-[13px] text-saa-muted leading-relaxed mb-4 max-w-prose line-clamp-2">
                {ep.description}
              </p>
            )}

            <!-- CTA -->
            <span class="font-sans inline-block text-[10px] font-semibold tracking-[0.1em] uppercase border-b border-saa-black pb-[1px]">
              Listen →
            </span>
          </a>
        </li>
      ))}
    </ol>
  )}

</Layout>
