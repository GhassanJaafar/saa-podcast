---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityClient } from "../../lib/sanity";

export async function getStaticPaths() {
  const episodes = await sanityClient.fetch(`
    *[_type == "episode" && defined(slug.current)] {
      "slug": slug.current
    }
  `);
  return episodes.map((ep: { slug: string }) => ({
    params: { slug: ep.slug },
  }));
}

const { slug } = Astro.params;

const episode = await sanityClient.fetch(
  `*[_type == "episode" && slug.current == $slug][0] {
    title,
    episodeNumber,
    "slug": slug.current,
    publishedAt,
    description,
    audioUrl,
    duration,
    fileSize,
    season,
    explicit,
    coverImage { asset->{ url } }
  }`,
  { slug }
);

if (!episode) {
  return Astro.redirect("/404");
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://podcast.sudanartarchive.com";

function formatDate(dateStr: string) {
  if (!dateStr) return "";
  return new Date(dateStr).toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function formatDuration(val: unknown) {
  if (!val) return null;
  // Sanity stores duration as "HH:MM:SS" string
  const parts = String(val).split(":").map(Number);
  if (parts.length < 2 || parts.some(isNaN)) return null;
  const [h, m, s] = parts.length === 3 ? parts : [0, parts[0], parts[1]];
  if (h > 0) return `${h} hr ${m} min`;
  return `${m} min ${String(s ?? 0).padStart(2, "0")} sec`;
}

const episodeCover = episode.coverImage?.asset?.url;
const ogImage =
  episodeCover ||
  import.meta.env.PUBLIC_COVER_IMAGE_URL ||
  `${siteUrl}/cover-season-1.jpg`;
const canonicalUrl = `${siteUrl}/episodes/${slug}`;
---

<BaseLayout
  title={episode.title}
  description={episode.description || `Episode ${episode.episodeNumber} of the Sudan Art Archive Podcast`}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  type="article"
>
  <style>
    .back-link {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 300;
      text-decoration: none;
      opacity: 0.6;
      margin-bottom: 2rem;
      transition: opacity 0.15s;
    }
    .back-link:hover { opacity: 1; color: var(--color-hover); }
    .back-link::before { content: "← "; }

    .episode-header { margin-bottom: 2rem; }

    .episode-label {
      font-size: 0.75rem;
      font-weight: 300;
      letter-spacing: 0.08em;
      opacity: 0.5;
      margin-bottom: 0.6rem;
    }

    h1 {
      font-size: 1.75rem;
      font-weight: 600;
      line-height: 1.25;
      margin-bottom: 0.75rem;
    }

    .episode-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
      font-size: 0.82rem;
      font-weight: 300;
      opacity: 0.6;
      margin-bottom: 1.5rem;
    }

    .episode-cover {
      width: 100%;
      max-width: 320px;
      border-radius: 6px;
      margin-bottom: 1.75rem;
      box-shadow: 0 4px 20px rgba(36,38,38,0.12);
    }

    .audio-player {
      width: 100%;
      margin-bottom: 2rem;
      accent-color: var(--color-hover);
    }

    .episode-description {
      font-size: 1rem;
      font-weight: 300;
      line-height: 1.75;
      opacity: 0.85;
    }

  </style>

  <a href="/" class="back-link">All episodes</a>

  <article>
    <header class="episode-header">
      <p class="episode-label">
        {episode.season ? `Season ${episode.season} · ` : ""}
        {episode.episodeNumber ? `Episode ${episode.episodeNumber}` : "Episode"}
      </p>

      <h1>{episode.title}</h1>

      <div class="episode-meta">
        {episode.publishedAt && <span>{formatDate(episode.publishedAt)}</span>}
        {episode.duration    && <span>{formatDuration(episode.duration)}</span>}
        {episode.explicit    && <span>Explicit</span>}
      </div>

      {episodeCover && (
        <img
          src={episodeCover}
          alt={`Cover art for ${episode.title}`}
          class="episode-cover"
          width="320"
          height="320"
        />
      )}

      {episode.audioUrl ? (
        <audio
          controls
          class="audio-player"
          preload="metadata"
        >
          <source src={episode.audioUrl} type="audio/mpeg" />
          Your browser does not support the audio element.
        </audio>
      ) : (
        <p style="font-style:italic; opacity:0.5; font-size:0.9rem; margin-bottom:1.5rem;">
          Audio coming soon.
        </p>
      )}
    </header>

    {episode.description && (
      <div class="episode-description">
        {episode.description.split("\n").map((line: string) =>
          line ? <p>{line}</p> : <br />
        )}
      </div>
    )}

  </article>
</BaseLayout>