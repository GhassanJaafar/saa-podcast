---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityClient } from "../../lib/sanity";

export async function getStaticPaths() {
  const episodes = await sanityClient.fetch(`
    *[_type == "episode" && defined(slug.current)] {
      "slug": slug.current
    }
  `);
  return episodes.map((ep: { slug: string }) => ({
    params: { slug: ep.slug },
  }));
}

const { slug } = Astro.params;

const episode = await sanityClient.fetch(
  `*[_type == "episode" && slug.current == $slug][0] {
    title,
    episodeNumber,
    "slug": slug.current,
    publishedAt,
    description,
    audioUrl,
    duration,
    fileSize,
    season,
    explicit,
    coverImage { asset->{ url } }
  }`,
  { slug }
);

if (!episode) {
  return Astro.redirect("/404");
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://podcast.sudanartarchive.com";

function formatDate(dateStr: string) {
  if (!dateStr) return "";
  return new Date(dateStr).toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function formatDuration(val: unknown) {
  if (!val) return null;
  // Sanity stores duration as "HH:MM:SS" string
  const parts = String(val).split(":").map(Number);
  if (parts.length < 2 || parts.some(isNaN)) return null;
  const [h, m, s] = parts.length === 3 ? parts : [0, parts[0], parts[1]];
  if (h > 0) return `${h} hr ${m} min`;
  return `${m} min ${String(s ?? 0).padStart(2, "0")} sec`;
}

const episodeCover = episode.coverImage?.asset?.url;
const ogImage =
  episodeCover ||
  import.meta.env.PUBLIC_COVER_IMAGE_URL ||
  `${siteUrl}/cover-season-1.jpg`;
const canonicalUrl = `${siteUrl}/episodes/${slug}`;
---

<BaseLayout
  title={episode.title}
  description={episode.description || `Episode ${episode.episodeNumber} of the Sudan Art Archive Podcast`}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  type="article"
>
  <style>
    .back-link {
      display: inline-block;
      font-size: 0.875rem;
      font-weight: 300;
      text-decoration: none;
      color: var(--saa-muted);
      margin-bottom: 2rem;
      transition: color var(--saa-transition);
    }
    .back-link:hover { color: var(--saa-accent); }
    .back-link::before { content: "← "; }

    .episode-header {
      background: var(--saa-cream);
      border: 1px solid var(--saa-sand);
      border-radius: var(--saa-radius-card);
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .episode-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--saa-muted);
      margin-bottom: 0.6rem;
    }

    h1 {
      font-size: clamp(1.5rem, 4vw, 2.25rem);
      font-weight: 300;
      line-height: 1.25;
      margin-bottom: 0.75rem;
    }

    .episode-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
      font-size: 0.82rem;
      font-weight: 300;
      color: var(--saa-muted);
      margin-bottom: 1.5rem;
    }

    .episode-cover {
      width: 100%;
      max-width: 280px;
      border-radius: var(--saa-radius-card);
      margin-bottom: 1.75rem;
      border: 1px solid var(--saa-sand);
    }

    /* ── Custom audio player ─────────────────────────────────── */
    .custom-player {
      background: var(--saa-white);
      border: 1px solid var(--saa-sand);
      border-radius: var(--saa-radius-card);
      padding: 1.25rem 1.5rem;
      margin-bottom: 0;
    }

    .player-row {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    /* Circular play/pause button */
    .player-play-btn {
      width: 2.75rem;
      height: 2.75rem;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--saa-text);
      color: var(--saa-cream);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--saa-transition), transform var(--saa-transition);
    }
    .player-play-btn:hover  { background: var(--saa-accent); }
    .player-play-btn:active { transform: scale(0.93); }
    .player-play-btn svg    { width: 0.875rem; height: 0.875rem; }
    .player-play-btn .icon-play   { display: block; margin-left: 2px; }
    .player-play-btn .icon-pause  { display: none; }
    .player-play-btn.is-playing .icon-play  { display: none; }
    .player-play-btn.is-playing .icon-pause { display: block; }

    /* Progress track + time */
    .player-meta {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .player-track {
      position: relative;
      height: 3px;
      background: var(--saa-sand);
      border-radius: 2px;
      cursor: pointer;
    }
    .player-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: 0%;
      background: var(--saa-accent);
      border-radius: 2px;
      pointer-events: none;
    }
    .player-seek {
      position: absolute;
      inset: -12px 0;
      width: 100%;
      opacity: 0;
      cursor: pointer;
      margin: 0;
      -webkit-appearance: none;
    }

    .player-time {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      font-weight: 300;
      color: var(--saa-muted);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
    }

    .episode-description {
      font-size: 1rem;
      font-weight: 300;
      line-height: 1.75;
      color: var(--saa-text);
    }
    .episode-description p + p { margin-top: 1rem; }

  </style>

  <a href="/" class="back-link">All episodes</a>

  <article>
    <header class="episode-header">
      <p class="episode-label">
        {episode.season ? `Season ${episode.season} · ` : ""}
        {episode.episodeNumber ? `Episode ${episode.episodeNumber}` : "Episode"}
      </p>

      <h1>{episode.title}</h1>

      <div class="episode-meta">
        {episode.publishedAt && <span>{formatDate(episode.publishedAt)}</span>}
        {episode.duration    && <span>{formatDuration(episode.duration)}</span>}
        {episode.explicit    && <span>Explicit</span>}
      </div>

      {episodeCover && (
        <img
          src={episodeCover}
          alt={`Cover art for ${episode.title}`}
          class="episode-cover"
          width="320"
          height="320"
        />
      )}

      {episode.audioUrl ? (
        <div class="custom-player" id="custom-player">
          {/* Hidden audio element */}
          <audio id="ep-audio" preload="metadata" src={episode.audioUrl}></audio>

          <div class="player-row">
            {/* Play / Pause button */}
            <button class="player-play-btn" id="ep-play-btn" aria-label="Play episode">
              {/* Play icon */}
              <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="6,3 20,12 6,21" />
              </svg>
              {/* Pause icon */}
              <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="5" y="4" width="4" height="16" rx="1"/>
                <rect x="15" y="4" width="4" height="16" rx="1"/>
              </svg>
            </button>

            <div class="player-meta">
              {/* Progress bar */}
              <div class="player-track" id="ep-track">
                <div class="player-fill" id="ep-fill"></div>
                <input
                  type="range"
                  class="player-seek"
                  id="ep-seek"
                  min="0"
                  max="100"
                  value="0"
                  step="0.1"
                  aria-label="Seek"
                />
              </div>
              {/* Time display */}
              <div class="player-time">
                <span id="ep-current">0:00</span>
                <span id="ep-total">–:––</span>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <p style="font-style:italic; color:var(--saa-muted); font-size:0.9rem; margin-bottom:1.5rem;">
          Audio coming soon.
        </p>
      )}
    </header>

    {episode.description && (
      <div class="episode-description">
        {episode.description.split("\n").map((line: string) =>
          line ? <p>{line}</p> : <br />
        )}
      </div>
    )}

  </article>
</BaseLayout>

<script>
  // Custom audio player logic
  const audio   = document.getElementById('ep-audio')   as HTMLAudioElement | null;
  const playBtn = document.getElementById('ep-play-btn') as HTMLButtonElement | null;
  const seekEl  = document.getElementById('ep-seek')     as HTMLInputElement  | null;
  const fillEl  = document.getElementById('ep-fill')     as HTMLDivElement    | null;
  const curEl   = document.getElementById('ep-current')  as HTMLElement       | null;
  const totEl   = document.getElementById('ep-total')    as HTMLElement       | null;

  if (audio && playBtn && seekEl && fillEl && curEl && totEl) {
    function fmt(s: number): string {
      if (!s || isNaN(s)) return '–:––';
      const m   = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${m}:${sec.toString().padStart(2, '0')}`;
    }

    audio.addEventListener('loadedmetadata', () => {
      totEl.textContent = fmt(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      fillEl.style.width = pct + '%';
      seekEl.value       = String(pct);
      curEl.textContent  = fmt(audio.currentTime);
    });

    audio.addEventListener('play',  () => playBtn.classList.add('is-playing'));
    audio.addEventListener('pause', () => playBtn.classList.remove('is-playing'));
    audio.addEventListener('ended', () => {
      playBtn.classList.remove('is-playing');
      fillEl.style.width = '0%';
      seekEl.value       = '0';
      curEl.textContent  = '0:00';
    });

    playBtn.addEventListener('click', () => {
      audio.paused ? audio.play() : audio.pause();
    });

    seekEl.addEventListener('input', () => {
      if (!audio.duration) return;
      audio.currentTime = (Number(seekEl.value) / 100) * audio.duration;
    });
  }
</script>